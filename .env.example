# Optional local analysis. No server/project/token is created by the build.
SONAR_HOST_URL=https://sonar.example.invalid
SONAR_PROJECT_KEY=L4D2-SpeedWatch
SONAR_PROJECT_NAME=L4D2-SpeedWatch
SONAR_QUALITY_GATE_WAIT=true
SONAR_QUALITY_GATE_TIMEOUT=300
# SONAR_TOKEN belongs to the environment or ignored .env.secret (mode 600).
# SONAR_COVERAGE_RECEIPT=.build/coverage/native/receipt.json
# SONAR_PYTHON_COVERAGE_RECEIPT=.build/coverage/python/receipt.json
SONAR_SOURCE_ENCODING=UTF-8
SONAR_SOURCES=extension,scripts
SONAR_EXCLUSIONS=**/__pycache__/**
SONAR_CXX_FILE_SUFFIXES=.c,.cc,.cpp,.cxx,.h,.hh,.hpp,.hxx
SONAR_CXX_ERROR_RECOVERY_ENABLED=false

SONAR_PYTHON_VERSION=3.12

# Opcionales para make sonar y make sonar-cppcheck.
# SONAR_COMPILE_COMMANDS=.build/exts-linux/compile_commands.json
# SONAR_CPPCHECK=cppcheck
# Solo para make sonar.
# SONAR_SCANNER=sonar-scanner
